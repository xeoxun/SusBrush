  m_text: "\u2460 \uC900\uBE44\uD558\uAE30\n4\uBA85 \uC774\uC0C1 \uBAA8\uC774\uACE0
    \uBAA8\uB450 \uC900\uBE44\uB97C \uC644\uB8CC\uD558\uBA74 \uAC8C\uC784\uC774 \uC2DC\uC791\uB429\uB2C8\uB2E4.\n\n\u2461
    \uC9C1\uC5C5\uACFC \uC81C\uC2DC\uC5B4 \uD655\uC778\n\uC790\uC2E0\uC758 \uC9C1\uC5C5\uACFC
    \uC81C\uC2DC\uC5B4\uB97C \uD655\uC778\uD558\uC138\uC694. \uC9C1\uC5C5\uACFC \uC81C\uC2DC\uC5B4\uB294
    \uAC8C\uC784\uC774 \uB05D\uB0A0 \uB54C\uAE4C\uC9C0 \uC720\uC9C0\uB429\uB2C8\uB2E4.\n\n\u2462
    \uADF8\uB9BC \uADF8\uB9AC\uAE30 \n\uC81C\uC2DC\uC5B4\uC5D0 \uB9DE\uB294 \uADF8\uB9BC\uC744
    \uADF8\uB9AC\uBA70 \uC218\uC0C1\uD55C \uD50C\uB808\uC774\uC5B4\uB97C \uCC3E\uC544\uBCF4\uC138\uC694.
    \uACBD\uBE44\uC6D0\uC740 \uC774 \uC2DC\uAC04\uC5D0\uB9CC \uC0AC\uACA9\uD560 \uC218
    \uC788\uC2B5\uB2C8\uB2E4.\n\n\u2463 \uD22C\uD45C\uD558\uAE30 \n\uB9C8\uD53C\uC544\uB85C
    \uC758\uC2EC\uB418\uB294 \uD50C\uB808\uC774\uC5B4\uB97C \uD074\uB9AD\uD558\uC138\uC694.
    \uB2E8, \uC0AC\uB9DD\uC790\uB294 \uD22C\uD45C\uD560 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4.\n\uB9C8\uD53C\uC544\uB294
    \uC774 \uC2DC\uAC04\uC5D0 \uC81C\uC2DC\uC5B4 \uC785\uB825\uCC3D\uC744 \uC5F4\uC5B4
    \uC815\uB2F5\uC744 \uBB34\uC81C\uD55C\uC73C\uB85C \uC81C\uCD9C\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.
    \uD2C0\uB9AC\uBA74 \uC785\uB825\uD55C \uC81C\uC2DC\uC5B4\uAC00 \uBAA8\uB450\uC5D0\uAC8C
    \uACF5\uAC1C\uB429\uB2C8\uB2E4.\n\n\u2464 \uCD5C\uD6C4\uC758 \uBCC0\uB860 \n\uB2E8\uB3C5
    \uCD5C\uB2E4 \uB4DD\uD45C\uC790\uC5D0\uAC8C \uBCC0\uB860 \uC2DC\uAC04\uC774 \uC8FC\uC5B4\uC9C0\uACE0,
    \uC2DC\uAC04\uC774 \uB05D\uB098\uBA74 \uCC98\uD615\uB429\uB2C8\uB2E4. \n"
